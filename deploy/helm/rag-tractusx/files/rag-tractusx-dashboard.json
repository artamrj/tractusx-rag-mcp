    {
      "id": 12,
      "type": "timeseries",
      "title": "Failed questions and upstream errors per minute",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
