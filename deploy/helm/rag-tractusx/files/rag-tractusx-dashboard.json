    {
      "id": 11,
      "type": "timeseries",
      "title": "Best-match similarity (avg)",
      "description": "Average cosine similarity of the best chunk; a drop means questions drift away from the indexed docs",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(rag_retrieval_top_score_sum{application=\"rag-tractusx\"}[$__rate_interval])) / sum(rate(rag_retrieval_top_score_count{application=\"rag-tractusx\"}[$__rate_interval]))",
          "legendFormat": "top score",
          "refId": "A",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
